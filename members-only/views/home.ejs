<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Members Only</title>
</head>
<body>
    <h1>Home</h1>
    <% if (user) { %>
        <p>Welcome <%= user.first_name %></p>
        <a href="/updateMembership">Update membership status</a>
        <a href="/posts/create">Create a post</a>
        <a href="/logout">Logout</a>
        <div class="posts">
            <% posts.forEach(post => { %>
               <div class="post">
                    <p><%= post.title %></p>
                    <p><%= post.content %></p>
                    <p><%= post.timestamp %></p>
                    <p><%= post.email %></p>
                    <% if (user.admin) { %>
                        <form method="post" action="/posts/<%= post.id %>/delete">
                            <button type="submit">Delete post</button>
                        </form>
                    <% } %>
               </div>
            <% }) %>
        </div>
    <% } else { %>
        <a href="/register">Sign up form</a>
        <a href="/login">Log In</a>
        <div>
            <% posts.forEach(post => { %>
                <div class="post">
                    <p><%= post.title %></p>
                    <p><%= post.content %></p>
                </div>    
            <% }) %>
        </div>
    <% } %>
</body>
</html>