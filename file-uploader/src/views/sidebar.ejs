<link rel="stylesheet" href="/styles/aside.css">
<aside>
    <div class="btn-container">
        <button class="btn" id="createFolderbtn">New Folder</button>
        <button class="btn" id="uploadFilebtn">New File</button>
        <% if (id) { %>
            <button class="btn" id="deleteFolderbtn">Delete Folder</button>
        <% } %>
    </div>

    <dialog id="createFolderDialog">
        <div class="dialog-header">
            <h1>New Folder</h1>
            <img src="/images/close.png" onclick="createFolderDialog.close()" alt="Close">
        </div>
        <form id="createFolderForm" method="post" action="<%= id ? `/folder/create?parent=${ id }` : '/folder/create' %>">
            <label for="name">Name:</label>
            <input type="text" name="name" id="name" maxlength="20" required>
            <button type="submit" class="btn">Create folder</button>
        </form>   
    </dialog> 

    <dialog id="uploadFileDialog">
        <div class="dialog-header">
            <h1>New File</h1>
            <img src="/images/close.png" onclick="uploadFileDialog.close()" alt="Close">
        </div>
        <form id="uploadFileForm" method="post" action="<%= id ? `/file/create?parent=${ id }` : '/file/create' %>" enctype="multipart/form-data">
            <input type="file" name="file" id="file" required>
            <button type="submit" class="btn">Upload file</button>
        </form>
    </dialog>

    <% if (id) { %>
        <dialog id="deleteFolderDialog">
            <div class="dialog-header">
                <h1>Delete folder</h1>
                <img src="/images/close.png" onclick="deleteFolderDialog.close()" alt="Close">
            </div>
            <form id="deleteFolderForm" method="post" action="/folder/<%= id %>/delete">
                <p>Are you sure?</p>
                <button type="submit" class="btn">Delete</button>
            </form>
        </dialog>
    <% } %>

    <dialog id="fileDetailsDialog">
        <div class="dialog-header">
            <h1>File information</h1>
            <img src="/images/close.png" onclick="fileDetailsDialog.close()" alt="Close">
        </div>
        <div class="details">
            <p>Filename: <span id="fileName"></span></p>
            <p>Size: <span id="fileSize"></span></p>
            <p>Uploaded At: <span id="fileDate"></span></p>
        </div>
        <form id='deleteFileForm' method="post" action="/file/" data-parent="<%= id  %>">
            <button class="btn" type="submit" id="deleteFileBtn">Delete</button>
            <a href="" download="" id="download">Download</a>
        </form>
    </dialog>
    
    
</aside>

