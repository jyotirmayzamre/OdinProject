<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/body.css">
    <link rel="stylesheet" href="/styles/form.css">

    <title>File Uploader</title>
</head>
<body>
    <%- include('navbar.ejs') %>
    <%- include("errors.ejs") %>
    <main>
        <div class="content-wrapper">
            <h2>Sign up</h2>
            <p>Already have an account? <a href="/login">Log in</a></p>
            <form method="post" action="/register">
                <div class="input-container">
                    <label for="email">Email*</label>
                    <input type="email" name="email" id="email" placeholder="hello@gmail.com" required>
                </div>
                <div class="input-container">
                    <label for="password">Password*</label>
                    <input type="password" name="password" id="password" minlength="3" placeholder="12345678" required>
                </div>
                <div class="input-container">
                    <label for="re-password">Confirm Password*</label>
                    <input type="password" name="re-password" id="re-password" minlength="3" placeholder="12345678" required>
                </div>
                <div class="input-container">
                    <button type="submit">Register</button>
                </div>
            </form>
        </div>
    </main>
    
    
</body>
</html>