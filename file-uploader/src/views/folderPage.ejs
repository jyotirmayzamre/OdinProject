<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Uploader</title>
</head>
<body>
    <div id="container">
        <% if (children) { %>
            <% children.forEach(child => { %>
                <div>
                    <a href="/folder/<%= child.id %>"><%= child.name  %></a>
                    <p><%= child.timestamp %></p>
                    <form method="post" action="/folder/<%= child.id %>/delete">
                        <button type="submit">Delete</button>
                    </form>
                </div>
            <% }) %>
        <% } %>
    </div>
    

    <form method="post" action="/folder/create?parent=<%= id %>">
        <label for="name">Folder Name:</label>
        <input type="text" name="name" id="name" maxlength="20" required>
        <button type="submit">Create new folder</button>
    </form>
    
</body>
</html>