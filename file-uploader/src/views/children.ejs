<link rel="stylesheet" href="/styles/children.css">
<main>
    <div class="child title-cont">
        <p>Type</p>
        <p>Name</p>
        <p>Created At</p>
    </div>
    <div class="children-container">
        <% if (locals.children) { %>
            <% children.forEach(elem => { %>
                <a href="/folder/<%= elem.id %>">
                    <div class="child">
                        <% if (elem.type === 'FOLDER') { %>
                            <img src="/images/folder.png" alt="Folder">
                        <% } else { %>
                            <img src="/images/document.png" alt="File">
                        <% } %>
                        <p><%= elem.name %></p>
                        <p><%= new Date(elem.timestamp).toLocaleDateString('en-GB') %></p>
                    </div>
                </a>
            <% }) %>
         
        <% } %>
    </div>
</main>