// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String   
  expiresAt   DateTime

  @@map("sessions")
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  documents Entity[]

  @@map("users")
}

enum EntityType {
  FOLDER
  FILE
}

model Entity {
  id Int @id @default(autoincrement())
  name String
  type EntityType
  timestamp DateTime @default(now())
  userId Int
  user User @relation(fields: [userId], references: [id])
  parentId Int?
  parent Entity? @relation(name: "EntityParent", fields: [parentId], references: [id], onDelete: Cascade)
  children Entity[] @relation(name: "EntityParent")

  @@index([parentId])
  @@index([userId])
  @@unique([userId, name, parentId])
  @@map("entities")
}