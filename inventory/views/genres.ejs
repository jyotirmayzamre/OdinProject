<html>
    <head>
        <title><%= title  %></title>
    </head>
    <body>
        <% if (locals.genres) { %>
            <% genres.forEach(genre => { %>
                <div class="genre-container" data-id="<%= genre.id %>">
                    <h1><%= genre.title %></h1>
                    <img src="/<%= genre.image  %>" />
                </div>
            <% }) %>
         
        <% } %>
    </body>
</html>