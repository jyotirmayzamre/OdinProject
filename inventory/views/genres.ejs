<html>
    <head>
        <title>Inventory App</title>
        <link rel="stylesheet" href="/genres.css">
    </head>
    <body>
        <%- include("nav.ejs") %>
        <main>
            <% if (locals.genres) { %>
                <% genres.forEach(genre => { %>
                    <a href="/genres/<%= genre.id %>">
                        <div class="card">
                            <img src="/<%= genre.image  %>" />
                            <h1><%= genre.title %></h1>
                        </div>
                    </a>
                    
                <% }) %>
            <% } %>
        </main>
        
    </body>
</html>