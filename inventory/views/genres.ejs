<html>
    <head>
        <title>Inventory App</title>
    </head>
    <body>
        <% if (locals.genres) { %>
            <% genres.forEach(genre => { %>
                <a href="/genres/<%= genre.id %>">
                    <div class="genre-container">
                        <h1><%= genre.title %></h1>
                        <img src="/<%= genre.image  %>" />
                    </div>
                </a>
                
            <% }) %>
         
        <% } %>
    </body>
</html>