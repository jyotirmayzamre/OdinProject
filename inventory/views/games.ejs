<html>
    <head>
        <title><%= title  %></title>
    </head>
    <body>
        <% if (locals.games) { %>
            <% games.forEach(game => { %>
                <h1><%= game.id %></h1>
                <img src="/<%= game.title_image  %>" />
            <% }) %>
        <% } %>
    </body>
</html>