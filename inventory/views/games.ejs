<html>
    <head>
        <title>Inventory App</title>
    </head>
    <body>
        <% if (locals.games) { %>
            <% games.forEach(game => { %>
                <a href="/games/<%= game.id %>">
                    <div class="game-container">
                        <img src="/<%= game.title_image  %>" />
                    </div>
                </a>
            <% }) %>
        <% } %>
    </body>
</html>