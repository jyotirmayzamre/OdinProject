<html>
    <head>
        <title>Inventory App</title>
        <link rel="stylesheet" href="/games.css">
    </head>
    <body>
        <%- include("nav.ejs") %>
        <% if (locals.games) { %>
            <main>
                <% games.forEach(game => { %>
                    <a href="/games/<%= game.id %>">
                        <div class="game-container">
                            <img src="/<%= game.title_image  %>" />
                        </div>
                    </a>
                <% }) %>
                </main>
        <% } %>
    </body>
</html>