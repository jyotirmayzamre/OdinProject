<html>
    <head>
        <title>Inventory App</title>
        <link rel="stylesheet" href="/game.css">
    </head>
    <body>
        <% if (locals.game) { %>
            <main>
                <section class="image-section">
                    <img src="/<%= game.full_image %>" />
                </section>
                <section class="info-section">
                    <img src="/<%= game.title_image  %>" />
                    <p><%= game.description  %></p>
                    <h2>$ <%= game.price  %></h2>
                    <p><b>Rating: </b><%= game.rating  %></p>
                    <p><b>Published: </b><%= game.publisher  %></p>
                    <p><b>Release Date: </b><%= game.release_date  %></p>
                    <p><i>Units available in stock: </i><%= game.units_available %></p>
                </section>
            </main>
        <% } %>
    </body>
</html>