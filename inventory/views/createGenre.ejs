<html>
    <head>
        <title>Inventory App</title>
        <link rel="stylesheet" href="/createGame.css">
    </head>
    <body>
        <%- include("nav.ejs") %>
        <main>
            <h1>Create Genre</h1>
            <div class="form-wrapper">
                <form method="post" action="/genres/create" enctype="multipart/form-data">
                    <label for="title">Title*:</label>
                    <input type="text" placeholder="Action, etc." name="title" id="title" minlength="3" maxlength="32" required>
                    <label for="desc">Description*:</label>
                    <textarea id="desc" name="desc" cols="30" rows="10" minlength="3" maxlength="500" required></textarea>
                    <label for="image">Image*:</label>
                    <input type="file" id="image"  name="image" accept="image/*" required>
                    
                    <div class="button-wrapper">
                        <button type="submit">Submit</button>
                    </div>
                   

                </form>
            </div>
        </main>
    </body>
</html>